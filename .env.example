# ==============================================================================
# VisionGuard AI — Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this template to .env and adjust values for your environment.
# NEVER commit sensitive production credentials or .env files to source control.

# Flask Application & Security Settings
FLASK_ENV=production
FLASK_DEBUG=0
VISIONGUARD_SECRET_KEY=change_me_to_a_secure_random_64_character_hex_string
VISIONGUARD_COOKIE_SECURE=1
AUTH_ENABLED=1

# Server Network Configuration
HOST=127.0.0.1
PORT=5000

# File Upload Limits & Storage
# Supported extensions: JPG, JPEG, PNG, BMP, WEBP
MAX_CONTENT_LENGTH_MB=15

# Persistent Database Storage (SQLite)
VISIONGUARD_DB_PATH=data/visionguard.db

# Authentic AI Detection Model Weights Checkpoints
VISIONGUARD_MODEL_PATH=ai/models/best.pt
VISIONGUARD_HOME_MODEL_PATH=ai/models/home_best.pt

# Safe Bootstrap Administrator Credentials (First-run only)
# Used to seed initial admin account if users table is empty.
# Leave blank to manually configure the admin through the initial setup modal.
VISIONGUARD_ADMIN_USERNAME=
VISIONGUARD_ADMIN_PASSWORD=
VISIONGUARD_ADMIN_EMAIL=
